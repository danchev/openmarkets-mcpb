{
  "manifest_version": "0.4",
  "name": "openmarkets",
  "display_name": "Open Markets",
  "version": "0.1.0",
  "description": "Financial market data, SEC filings, macroeconomic telemetry, and portfolio analytics.",
  "long_description": "Connect Claude Desktop to 127 read-only financial research tools across equities, fixed income, commodities, currencies, funds, crypto, macroeconomics, SEC EDGAR, and quantitative portfolio analytics.",
  "author": {
    "name": "Danchev",
    "url": "https://github.com/danchev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/danchev/openmarkets-mcpb"
  },
  "homepage": "https://openmarkets.dev",
  "documentation": "https://danchev.github.io/openmarkets/",
  "support": "https://github.com/danchev/openmarkets/issues",
  "server": {
    "type": "uv",
    "entry_point": "server/main.py",
    "mcp_config": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${__dirname}",
        "server/main.py"
      ]
    }
  },
  "tools_generated": true,
  "keywords": [
    "finance",
    "markets",
    "investing",
    "SEC",
    "macroeconomics",
    "portfolio"
  ],
  "license": "AGPL-3.0-or-later",
  "privacy_policies": [
    "https://legal.yahoo.com/us/en/yahoo/privacy/index.html",
    "https://www.dowjones.com/privacy-notice/",
    "https://fred.stlouisfed.org/legal/",
    "https://www.sec.gov/privacy.htm",
    "https://www.bloomberg.com/notices/privacy/"
  ],
  "compatibility": {
    "platforms": [
      "darwin",
      "linux",
      "win32"
    ],
    "runtimes": {
      "python": ">=3.10"
    }
  }
}
